<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        app:resize_mode="fill"
        app:use_controller="false" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        app:resize_mode="fill"
        app:use_controller="false" />

    <!-- Touch control overlay -->
    <FrameLayout
        android:id="@+id/touch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Channel info at top -->
        <LinearLayout
            android:id="@+id/channel_info_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:background="#80000000"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/channel_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:text="CCTV1 综合" />

            <TextView
                android:id="@+id/btn_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Center navigation area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Previous channel -->
            <FrameLayout
                android:id="@+id/btn_prev"
                android:layout_width="80dp"
                android:layout_height="120dp"
                android:layout_marginStart="8dp"
                android:background="#40000000"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="◀"
                    android:textColor="#ccffffff"
                    android:textSize="32sp" />
            </FrameLayout>

            <!-- Center tap area (empty, for tap to hide controls) -->
            <View
                android:id="@+id/center_tap_area"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true" />

            <!-- Next channel -->
            <FrameLayout
                android:id="@+id/btn_next"
                android:layout_width="80dp"
                android:layout_height="120dp"
                android:layout_marginEnd="8dp"
                android:background="#40000000"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#ccffffff"
                    android:textSize="32sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Bottom hint -->
        <LinearLayout
            android:id="@+id/bottom_hint"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:background="#80000000"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀ 换台 ▶  |  点按菜单  |  双击设置"
                android:textColor="#99ffffff"
                android:textSize="12sp" />
        </LinearLayout>

    </FrameLayout>
</FrameLayout>
